{
  "rules": {
    "sessions": {
      "$code": {
        ".read": true,
        "meta": {
          ".write": "true",
          ".validate": "newData.hasChildren(['name', 'phase', 'createdAt', 'hostKey', 'cap'])",
          "hostKey": {
            ".read": false,
            ".validate": "newData.isString() && newData.val().length >= 20"
          },
          "phase": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "cap": {
            ".validate": "newData.isNumber()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "hostClaim": {
          ".read": false,
          ".write": true,
          ".validate": "newData.isString() && newData.val() === root.child('sessions/' + $code + '/meta/hostKey').val()"
        },
        "participants": {
          "$pid": {
            ".write": "!data.exists() || data.child('avatarId').val() === newData.child('avatarId').val()",
            ".validate": "newData.hasChildren(['avatarId', 'joinedAt'])",
            "avatarId": { ".validate": "newData.isString()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "doneWishing": { ".validate": "newData.isBoolean()" },
            "recapSeen": { ".validate": "newData.isBoolean()" },
            "doneAllocating": { ".validate": "newData.isBoolean()" },
            "doneResults": { ".validate": "newData.isBoolean()" },
            "tokens": {
              "$cid": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              }
            }
          }
        },
        "avatars": {
          "$avatarId": {
            ".validate": "newData.isString()"
          }
        },
        "wishes": {
          "$wid": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['text', 'authorPid', 'avatarId', 'createdAt']) && newData.child('text').val().length > 0 && newData.child('text').val().length <= 90",
            "collectiveId": { ".validate": "newData.isString() || newData.val() === null" }
          }
        },
        "collectives": {
          "$cid": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['title', 'createdAt'])",
            "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 90" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "autoPromoted": { ".validate": "newData.isBoolean()" }
          }
        },
        "reveal": {
          "index": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
